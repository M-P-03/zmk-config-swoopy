#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T        &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G        &kp H    &kp J    &kp K    &kp L    &kp SEMI
                &kp Z    &kp X    &kp C    &kp V    &kp B        &kp N    &kp M    &kp COMMA &kp DOT &kp FSLH
                                  &none    &kp LSFT &kp SPC      &kp BSPC  &kp RSFT    &kp RET
            >;
        };

        lower_layer {
            bindings = <
                &none   &kp N7   &kp N8   &kp N9   &kp STAR      &none   &none    &kp UP     &none     &none
                &kp SLASH  &kp N4   &kp N5   &kp N6  &kp PLUS      &none   &kp LEFT &kp DOWN   &kp RIGHT &none
                &none   &kp N1   &kp N2   &kp N3   &kp MINUS     &none   &none    &none      &none     &none
                                  &none   &kp N0      &trans     &trans  &trans   &trans
            >;
        };
    };
    combos {
        compatible = "zmk,combos";

        combo_lower {
            timeout-ms = <50>;
            key-positions = <31 14>;
            bindings = <&to 0>;
        };

        combo_upper {
            timeout-ms = <50>;
            key-positions = <31 24>;
            bindings = <&to 1>;
        };
    };
};