#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T               &kp Y    &kp U    &kp I    &kp O    &kp P
                &kp A    &kp S    &kp D    &kp F    &kp G               &kp H    &kp J    &kp K    &kp L    &kp SEMI
                &kp Z    &kp X    &kp C    &kp V    &kp B               &kp N    &kp M    &kp COMMA &kp DOT &kp FSLH
                                  &none    &kp LCTRL &kp SPC       &kp BSPC  &kp RSFT    &kp RET
            >;
        };

        upper_layer {
            bindings = <
                &none   &kp N7   &kp N8   &kp N9   &kp KP_MULTIPLY          &kp LBKT   &kp RBKT    &kp none     &none     &none
                &kp KP_DIVIDE  &kp N4   &kp N5   &kp N6  &kp KP_PLUS        &kp LPAR   &kp RPAR    &kp LT   &kp GT &none
                &none   &kp N1   &kp N2   &kp N3   &kp KP_MINUS             &kp LBRC   &kp RBRC    &none      &none     &none
                                  &none   &kp N0      &trans                &trans  &trans   &trans
            >;
        };

        lower_layer {
            bindings = <
                &none   &kp N7   &kp N8   &kp N9   &kp KP_MULTIPLY          &none   &none    &kp UP     &none     &none
                &kp KP_DIVIDE  &kp N4   &kp N5   &kp N6  &kp KP_PLUS        &none   &kp LEFT &kp DOWN   &kp RIGHT &none
                &none   &kp N1   &kp N2   &kp N3   &kp KP_MINUS             &none   &none    &none      &none     &none
                                  &none   &kp N0      &trans                &trans  &trans   &trans
            >;
        };
    };
    combos {
        compatible = "zmk,combos";

        combo_lower {
            timeout-ms = <50>;
            key-positions = <32 24>;
            bindings = <&to 0>;
        };

        combo_upper {
            timeout-ms = <50>;
            key-positions = <32 14>;
            bindings = <&to 2>;
        };

        combo_klam {
            timeout-ms = <50>;
            key-positions = <32 4>;
            bindings = <&to 1>;
        };

        combo_oe {
            timeout-ms = <50>;
            key-positions = <8 32>;
            bindings = <&to 1>;
        };

        combo_ae {
            timeout-ms = <50>;
            key-positions = <10 33>;
            bindings = <&to 1>;
        };

        combo_ue {
            timeout-ms = <50>;
            key-positions = <6 32>;
            bindings = <&to 1>;
        };
    };
};